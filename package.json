{
  "name": "credits-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:browser": "node scripts/smoke.mjs",
    "test:offline": "node scripts/offline-smoke.mjs",
    "test:ios": "node scripts/ios-smoke.mjs",
    "build:ios:web": "node scripts/build-ios-web.mjs",
    "ios:sync": "npm run build:ios:web && cap sync ios",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "next": "^16.4.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.0",
    "playwright-core": "^1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22.13 <23 || >=24"
  }
}
